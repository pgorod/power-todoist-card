{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.js"],
  "exclude": ["node_modules", "dist", "powertodoist-card.js"]
}
